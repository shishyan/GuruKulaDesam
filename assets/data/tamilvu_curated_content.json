        {"name": "நிலவேம்பு (Andrographis paniculata)", "benefit": "காய்ச்சல், வைரஸ் நச்சுக்களை வேரறுத்து நோய் எதிர்ப்பு மண்டலத்தை பலப்படுத்தும் கசப்பு மூலிகை"},
        {"name": "துளசி (Ocimum sanctum)", "benefit": "ஆக்ஸிஜன் பெருக்கி, மன அழுத்தத்தை சமன் செய்து உடலுக்கு தெய்வீக ஆற்றலைத் தரும் புனிதத் தழை"},
        {"name": "கீழாநெல்லி (Phyllanthus niruri)", "benefit": "கல்லீரலைப் பாதுகாத்து பித்தத்தைச் சமன் செய்யும் உன்னத மூலிகை"}
      ],
      "ashtama_siddhis": [
        {"siddhi": "அணிமா", "meaning": "அணுவைப் போல் மிக நுண்ணிய வடிவத்தைப் பெறுதல்"},
        {"siddhi": "மகிமா", "meaning": "மலை போல் பிரம்மாண்டமாகப் பேருருவம் கொள்ளுதல்"},
        {"siddhi": "லகிமா", "meaning": "காற்றை விட லேசாகி அந்தரத்தில் மிதத்தல்"},
        {"siddhi": "கரிமா", "meaning": "இரும்பை விடக் கனமாக உடலை மாற்றுதல்"},
        {"siddhi": "பிராப்தி", "meaning": "நினைத்த இடத்திற்கு உடனடியாகச் செல்லும் ஆற்றல்"},
        {"siddhi": "பிராகாமியம்", "meaning": "விரும்பிய எதையும் உடனடியாகப் படைக்கும் ஆற்றல்"},
        {"siddhi": "ஈசத்துவம்", "meaning": "இயற்கையின் பஞ்சபூதங்களையும் இயக்கும் தலைவாற்றல்"},
        {"siddhi": "வசித்துவம்", "meaning": "அனைத்து ஜீவராசிகளையும் அன்பால் வசப்படுத்தும் அருள்"}
