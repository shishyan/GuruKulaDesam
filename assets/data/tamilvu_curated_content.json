    "siddha_18_tradition_and_medicine": {
      "title": "பதினெண் சித்தர்கள் மரபு & சித்த மருத்துவ வாழ்வியல்",
      "source_tva": "Tamil Virtual Academy - சித்தர் இலக்கியம் & சித்த மருத்துவம்",
      "motto": "உடம்பார் அழியின் உயிரார் அழிவர்... உடம்பை வளர்த்தேன் உயிர் வளர்த்தேனே (திருமந்திரம் 724)",
      "siddhars_18": [
        {"order": 1, "name": "ஸ்ரீ அகத்தியர்", "focus": "சித்த மருத்துவத்தின் முதல் குரு, தமிழ் இலக்கணம் & நாடி சாஸ்திரம்", "shrine": "திருவனந்தபுரம் / அகத்தியர்கூடம்"},
        {"order": 2, "name": "ஸ்ரீ திருமூலர்", "focus": "யோக தத்துவம், திருமந்திரம் (3,000 பாடல்கள்), காயகற்பம்", "shrine": "சிதம்பரம்"},
        {"order": 3, "name": "ஸ்ரீ போகர்", "focus": "ரசவாதம், பழனி நவபாஷாண தண்டாயுதபாணி சிலை வடித்தல்", "shrine": "பழனி"},
        {"order": 4, "name": "ஸ்ரீ கோரக்கர்", "focus": "மூலிகை மருத்துவம், சந்திர ரேகை, காயசித்தி", "shrine": "பொய்கையூர் / நாகப்பட்டினம்"},
        {"order": 5, "name": "ஸ்ரீ கொங்கணர்", "focus": "குண்டலினி வாசி யோகம், கொங்கணர் வாக்கியம் (உயர் மெய்ஞ்ஞானம்)", "shrine": "திருப்பதி"},
        {"order": 6, "name": "ஸ்ரீ சிவவாக்கியர்", "focus": "உருவ வழிபாட்டைக் கடந்த அத்வைத சிவ ஞானம், புரட்சிகர வெண்பாக்கள்", "shrine": "கும்பகோணம்"},
        {"order": 7, "name": "ஸ்ரீ இடைக்காடர்", "focus": "விண்வெளி சாஸ்திரம், பஞ்ச பூதக் கட்டுப்பாடு, கோள்களின் இயக்கம்", "shrine": "திருவண்ணாமலை"},
        {"order": 8, "name": "ஸ்ரீ சட்டைமுனி", "focus": "வாத காவியம், நவரத்தின மூலிகை வேதியியல்", "shrine": "ஸ்ரீரங்கம்"},
        {"order": 9, "name": "ஸ்ரீ பாம்பாட்டிச் சித்தர்", "focus": "குண்டலினி பாம்பை எழுப்பும் வாசி யோக சூட்சுமங்கள்", "shrine": "மருதமலை (கோவை)"},
        {"order": 10, "name": "ஸ்ரீ குதம்பைச் சித்தர்", "focus": "உள்முக தியானம், மன அடக்கம், குதம்பை பாவனை", "shrine": "மாயவரம்"},
        {"order": 11, "name": "ஸ்ரீ அழுகணிச் சித்தர்", "focus": "பக்தி வைராக்கியம், ஆண்டவனிடம் அழுகைக் கண்ணீர் சமர்ப்பணம்", "shrine": "நாகப்பட்டினம்"},
        {"order": 12, "name": "ஸ்ரீ கருவூரார்", "focus": "தஞ்சைப் பெரிய கோயில் சிவலிங்கப் பிரதிஷ்டை, தந்திர சாஸ்திரம்", "shrine": "கரூர் / தஞ்சாவூர்"},
        {"order": 13, "name": "ஸ்ரீ காலாங்கி நாதர்", "focus": "போகரின் குரு, ஞான உபதேசம், சீன-பாரத சித்தப் பாலம்", "shrine": "காஞ்சிபுரம்"},
        {"order": 14, "name": "ஸ்ரீ புலிப்பாணி", "focus": "போகரின் முதன்மை சீடர், ஜால சூத்திரம், மூலிகைப் பிரயோகம்", "shrine": "பழனி"},
        {"order": 15, "name": "ஸ்ரீ தன்வந்திரி", "focus": "ஆயுர்வேத & சித்த மூலிகை சிகিৎசா விதிமுறைகள்", "shrine": "வைத்தீஸ்வரன் கோயில்"},
        {"order": 16, "name": "ஸ்ரீ தேரையர்", "focus": "நோய் நாடி நோய் முதல் நாடல், அறுவை சிகிச்சை & பத்திய முறைகள்", "shrine": "தோரணமலை / கட்டபொம்மன் குன்று"},
        {"order": 17, "name": "ஸ்ரீ உரோமரிஷி", "focus": "காயகற்ப யோகம், முக்குண சமநிலை", "shrine": "அவநாசி"},
        {"order": 18, "name": "ஸ்ரீ வான்மீகர்", "focus": "ராமாயண மூல ஞானம், தவ நிலை", "shrine": "எட்டுக்குடி"}
      ],
