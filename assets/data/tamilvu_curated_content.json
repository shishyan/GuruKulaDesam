    "meikanda_sastras": {
      "title": "சைவ சித்தாந்த 14 மெய்கண்ட சாத்திரங்கள்",
      "items": [
        {"order": 1, "title": "திருவுந்தியார்", "author": "திருவியலூர் உய்யவந்த தேவநாயனார்", "description": "காலத்தால் முந்திய சாத்திர நூல், ஞான உபதேசம்"},
        {"order": 2, "title": "திருக்களிற்றுப்படியார்", "author": "திருக்கடவூர் உய்யவந்த தேவநாயனார்", "description": "தில்லை யானைப்படியில் எழுந்த ஞான நூல்"},
        {"order": 3, "title": "சிவஞானபோதம்", "author": "மெய்கண்ட தேவநாயனார்", "description": "சைவ சித்தாந்தத்தின் தலையாய மூல நூல் (12 சூத்திரங்கள்)"},
        {"order": 4, "title": "சிவஞானசித்தியார்", "author": "அருணந்தி சிவாச்சாரியார்", "description": "பரபக்கம், சுபக்கம் கொண்ட சித்தாந்தப் பேருரை"},
        {"order": 5, "title": "இருபா இருபஃது", "author": "அருணந்தி சிவாச்சாரியார்", "description": "மெய்கண்டாரிடம் கேட்கப்படும் 20 தத்துவ வினாக்கள்"},
        {"order": 6, "title": "உண்மை விளக்கம்", "author": "மனவாசகங்கடந்தார்", "description": "பஞ்சாட்சரம் மற்றும் நடராஜர் கூத்தின் ரகசியம்"},
        {"order": 7, "title": "சிவப்பிரகாசம்", "author": "உமாபதி சிவாச்சாரியார்", "description": "சித்தாந்த உண்மைகளின் விரிவான பிரகாசம்"},
        {"order": 8, "title": "திருவருட்பயன்", "author": "உமாபதி சிவாச்சாரியார்", "description": "திருக்குறள் வெண்பா அமைப்பில் அமைந்த 100 குறள்கள்"},
        {"order": 9, "title": "வினா வெண்பா", "author": "உமாபதி சிவாச்சாரியார்", "description": "ஆசிரியரிடம் சீடன் கேட்கும் 13 வெண்பா வினாக்கள்"},
        {"order": 10, "title": "போற்றிப் பஃறொடை", "author": "உமாபதி சிவாச்சாரியார்", "description": "இறைவனின் திருவருளைப் போற்றும் பஃறொடை வெண்பா"},
        {"order": 11, "title": "கொடிக்கவி", "author": "உமாபதி சிவாச்சாரியார்", "description": "சிதம்பரக் கோயில் கொடியேற்ற தத்துவப் பாடல்"},
        {"order": 12, "title": "நெஞ்சுவிடு தூது", "author": "உமாபதி சிவாச்சாரியார்", "description": "மனதை இறைவனிடம் தூதாக அனுப்பும் கலிவெண்பா"},
        {"order": 13, "title": "உண்மைநெறி விளக்கம்", "author": "உமாபதி சிவாச்சாரியார்", "description": "தசகாரியங்களின் நுட்பமான விளக்கம்"},
        {"order": 14, "title": "சங்கற்ப நிராகரணம்", "author": "உமாபதி சிவாச்சாரியார்", "description": "பல்வேறு தத்துவப் பிரிவுகளின் வாதங்களை மறுத்து சித்தாந்தம் நிலைநாட்டல்"}
      ]
    },
    "siddhanta_triad": {
      "pathi": "சிவம் - எண்குணத்தான், சச்சிதானந்தப் பேரொளி, ஐந்தொழில் நடத்தும் முழுமுதற்பொருள்",
      "pasu": "ஆன்மாக்கள் - அனாதியானவை, சார்ந்ததன் வண்ணமாய் மாறும் இயல்புடையவை",
      "paasam": {
        "aanavam": "மூல இருள் மலம் (அகந்தை, அறியாமை)",
        "kanmam": "நல்வினை, தீவினைப் பயன்களை விளைவிக்கும் செயல்பாடு",
        "maayai": "தனு, கரண, புவன, போகங்களை வழங்கும் பிரபஞ்ச மூலப்பொருள்"
      }
    },
