{
  "manifest_version": 3,
  "name": "DarkZen \u2014 Free Universal OLED Dark Mode, Blue-Light Filter & Zen Reader",
  "short_name": "DarkZen",
  "version": "1.0.0",
  "description": "100% Free Dark Reader Pro & Helperbird alternative: Per-site OLED dark theme, media-preserving smart inversion, warm blue-light filter & 1-click Zen Reader.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DarkZen \u2014 Free Universal OLED Dark Mode, Blue-Light Filter & Zen Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "darkzen@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}