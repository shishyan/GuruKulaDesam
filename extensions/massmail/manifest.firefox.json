{
  "manifest_version": 3,
  "name": "MassMail \u2014 Free Gmail Mail Merge, Follow-Up Sequence & Template Engine",
  "short_name": "MassMail",
  "version": "1.0.0",
  "description": "100% Free GMass & Mailtrack alternative: Unlimited personalized {{FirstName}} merge templates, 1-click Gmail compose insertion & zero email watermarks.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MassMail \u2014 Free Gmail Mail Merge, Follow-Up Sequence & Template Engine",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "massmail@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}