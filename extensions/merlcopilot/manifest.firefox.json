{
  "manifest_version": 3,
  "name": "MerlCopilot \u2014 Free AI Sidebar, Page Summarizer & Research Assistant",
  "short_name": "MerlCopilot",
  "version": "1.0.0",
  "description": "100% Free Merlin AI & MaxAI.me alternative: Instant 1-click page TL;DR, key bullet extractor, reading time estimator & markdown notes exporter.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MerlCopilot \u2014 Free AI Sidebar, Page Summarizer & Research Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "merlcopilot@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}