{
  "manifest_version": 3,
  "name": "HuntLead \u2014 Free B2B Email Finder, Domain Search & Lead Extractor",
  "short_name": "HuntLead",
  "version": "1.0.0",
  "description": "100% Free Hunter.io & Apollo.io alternative: Unlimited on-page email extraction, corporate email pattern permutator, phone finder & 1-click CSV export.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "HuntLead \u2014 Free B2B Email Finder, Domain Search & Lead Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "huntlead@gurukuladesam.org",
      "strict_min_version": "109.0"
    }
  }
}