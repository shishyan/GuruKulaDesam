{
  "manifest_version": 3,
  "name": "TubeIQ \u2014 Free YouTube SEO, Outlier Finder & Studio Toolkit",
  "short_name": "TubeIQ",
  "version": "1.0.0",
  "description": "100% Free vidIQ, TubeBuddy & 1of10 alternative: Outlier Multiplier & VPH badges, Live Keyword Explorer, Tag Extractor & 100-pt SEO Scorecard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TubeIQ \u2014 Free YouTube SEO & Outlier Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://studio.youtube.com/*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "https://www.youtube.com/*"
  ]
}