{
  "manifest_version": 3,
  "name": "SurfSEO \u2014 Free SERP Keyword Explorer, On-Page SEO Audit & Rank Toolkit",
  "short_name": "SurfSEO",
  "version": "1.0.0",
  "description": "100% Free Keywords Everywhere, Surfer SEO & MozBar alternative: Instant 100-pt on-page SEO audit, NLP keyword density, H1-H6 tree & live SERP keyword explorer.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SurfSEO \u2014 Free SERP Keyword Explorer, On-Page SEO Audit & Rank Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*",
    "<all_urls>"
  ]
}